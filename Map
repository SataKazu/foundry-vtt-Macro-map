    _statusBlock() {
      const icon =
        this.busy ? "fa-solid fa-spinner fa-spin" :
        this.status.tone === "error" ? "fa-solid fa-triangle-exclamation" :
        this.status.tone === "done" ? "fa-solid fa-circle-check" :
        "fa-solid fa-circle-info";
      const progress = typeof this.status.progress === "number"
        ? `<div class="dmi-progress"><div style="width:${clamp(this.status.progress, 0, 100)}%"></div></div>` : "";
      const summary = this.status.summary ? `
        <div class="dmi-summary">
          <div class="dmi-pill"><strong>${this.status.summary.folders}</strong><span>папок</span></div>
          <div class="dmi-pill"><strong>${this.status.summary.scenes}</strong><span>Scenes</span></div>
          <div class="dmi-pill"><strong>${this.status.summary.images}</strong><span>карт</span></div>
          <div class="dmi-pill"><strong>${this.status.summary.duplicates}</strong><span>дублей</span></div>
        </div>` : "";
      const rows = this.status.rows?.length ? `
        <div class="dmi-rows">
          ${this.status.rows.slice(0, 30).map(r => `
            <div class="dmi-row">
              <span class="path" title="${escapeHtml(r.path)}">${escapeHtml(r.path)}</span>
