            <label>Хранилище</label>
            <select name="source" ${d}>${sources}</select>
            <label>Папка с картами</label>
            <div class="dmi-path">
              <input type="text" name="root" value="${escapeHtml(o.root)}" ${d} />
              <button type="button" data-action="browse" ${d}><i class="fas fa-folder-open"></i></button>
            </div>
            <label>Размер клетки</label>
            <input type="number" name="gridSize" min="1" max="1000" value="${Number(o.gridSize)}" ${d} />
            <label>Футов на клетку</label>
