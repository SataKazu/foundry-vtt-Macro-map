(async () => {

  console.log("DMI: старт");

  const ApplicationV1 = foundry.appv1?.api?.Application ?? globalThis.Application;
  if (!ApplicationV1) { ui.notifications.error("Application не найден."); return; }
  if (!game.user.isGM) { ui.notifications.warn("Только GM."); return; }

  const FilePickerImpl =
    foundry.applications?.apps?.FilePicker?.implementation ??
    foundry.applications?.apps?.FilePicker ??
    globalThis.FilePicker;
  if (!FilePickerImpl) { ui.notifications.error("FilePicker не найден."); return; }


  const CONFIG_KEY = "dnd-map-importer";
  const UNZIP_BASE = "assets";
  const DEFAULT_SUBFOLDER = "DND Maps";
  const RENDER_THROTTLE_MS = 120;

  const IMAGE_EXT = new Set([".png", ".jpg", ".jpeg", ".webp"]);
  const IMAGE_MIME = {
    ".png": "image/png", ".jpg": "image/jpeg",
    ".jpeg": "image/jpeg", ".webp": "image/webp"
  };
  const LEGACY_PREFIXES = ["DND Maps - ", "Карты - "];

  const DEFAULT_OPTIONS = {
    source: "data",
    root: "assets/DND Maps",
    createRootFolder: false,
    recursive: true,
    gridSize: 100,
    gridDistance: 5,
    gridUnits: "ft",
    activateAfterImport: false,
    skipDuplicates: true
  };


  class DNDMapImporterApp extends ApplicationV1 {

    static get defaultOptions() {
      return foundry.utils.mergeObject(super.defaultOptions, {
        id: "dnd-map-importer",
        title: "Импортёр D&D карт",
        width: 620, height: "auto", resizable: false,
        classes: ["dnd-map-importer"]
      });
    }

    constructor(options = {}) {
      super(options);
      this.optionsState = loadOptions();
      this.busy = false;
      this.screen = "home";
      this.deletePlan = null;
      this._lastRender = 0;
      this.status = {
        tone: "idle", title: "Импорт карт",
        detail: "Выбери ZIP с картами или укажи папку с изображениями.",
        progress: null, summary: null, rows: []
      };
    }

    async getData() { return {}; }

    async _renderInner() {
      const $w = $(`<div class="dmi-root"></div>`);
      $w.html(this._buildTemplate());
      return $w;
    }

    activateListeners(html) {
      super.activateListeners(html);
      html.on("click", "[data-action]", this._onAction.bind(this));
    }

    async _onAction(ev) {
      ev.preventDefault(); ev.stopPropagation();
      if (this.busy) return;
      const action = ev.currentTarget?.dataset?.action;
      switch (action) {
        case "pickZip":       return this.pickAndExtractZip();
        case "openImporter":  return this._openSetup();
        case "browse":        return this.browseFolder();
        case "preview":       return this.runPreview();
        case "import":        return this.runImport();
        case "prepareDelete": return this.prepareDelete();
        case "confirmDelete": return this.confirmDelete();
        case "clearDelete":   return this._clearDelete();
      }
    }

    _openSetup() {
      this.screen = "setup";
      this.status = {
        tone: "idle", title: "Готово к проверке",
        detail: "Выбери папку с картами и нажми «Проверить».",
        progress: null, summary: null, rows: []
      };
      this._refresh();
    }

    _clearDelete() { this.deletePlan = null; this._refresh(); }

    _refresh() {
      if (!this.element) return;
      const $root = this.element.find(".dmi-root");
      if ($root.length) {
        $root.html(this._buildTemplate());
        this.activateListeners(this.element);
      } else {
        this.render(false);
      }
    }

    _updateStatusBlock() {
      const $s = this.element?.find(".dmi-status");
      if ($s?.length) $s.replaceWith(this._statusBlock());
      else this._refresh();
    }

    async beginBusy(title = "Работаю...") {
      this.busy = true;
      this.status = { tone: "busy", title, detail: "", progress: null,
                      summary: this.status.summary, rows: this.status.rows };
      this._lastRender = Date.now();
      this._refresh();
    }

    async endBusy() { this.busy = false; this._refresh(); }

    setStatus(tone, title, detail, progress = null,
              { summary, rows, force = false } = {}) {
      this.status = {
        tone, title, detail, progress,
        summary: summary ?? this.status.summary,
        rows: rows ?? this.status.rows
      };
      const now = Date.now();
      if (!force && now - this._lastRender < RENDER_THROTTLE_MS) return;
      this._lastRender = now;
      this._updateStatusBlock();
    }

 

    _buildTemplate() {
      return `<style>${this._styles()}</style>` +
             (this.screen === "home" ? this._homeScreen() : this._setupScreen());
    }

