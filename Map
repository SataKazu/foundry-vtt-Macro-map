    _homeScreen() {
      const d = this.busy ? "disabled" : "";
      return `
        <div class="dmi-home">
          <button type="button" class="dmi-home-btn" data-action="pickZip" ${d}>
            <i class="fa-solid fa-file-zipper"></i>
            <div>
              <strong>Импортировать ZIP с картами</strong>
              <span>Распакует в Data/${UNZIP_BASE}/&lt;имя архива&gt;/ и создаст папки и Scenes.</span>
            </div>
          </button>
          <button type="button" class="dmi-home-btn" data-action="openImporter" ${d}>
            <i class="fa-solid fa-map"></i>
            <div>
